{
  "name": "abdulrehman-malik/pak-gas-app",
  "description": "LPG retail POS and inventory system built with custom PHP.",
  "type": "project",
  "require": {
    "php": "^8.1",
    "ext-pdo": "*",
    "phpoffice/phpspreadsheet": "^3.0",
    "ext-bcmath": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    },
    "files": [
      "app/Helpers/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
